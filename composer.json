{
    "name": "slendie/framework",
    "description": "Slendie Framework packages",
    "keywords": ["php","slendie","framework"],
    "homepage": "https://slendie.lcloss.dev",
    "license": "MIT",
    "authors": [
        {
            "name": "Luciano Closs",
            "email": "lcloss@gmail.com",
            "homepage": "https://lucianocloss.com",
            "role": "Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "Slendie\\Framework\\": "src/Framework/",
            "Slendie\\Controllers\\": "src/Controllers/",
            "Slendie\\Models\\": "src/Models/"
        },
        "files": [
            "src/helpers/functions.php"
        ]
    },
    "require": {
        "php": ">=8.4",
        "vlucas/phpdotenv": "^5.6",
        "phpmailer/phpmailer": "^7.0"
    },
    "require-dev": {
        "laravel/pint": "^1.26",
        "pestphp/pest": "4.x-dev",
        "phpstan/phpstan": "^2.1"
    },
    "scripts": {
        "test": "php run-tests.php"
    },    
    "minimum-stability": "dev",
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
